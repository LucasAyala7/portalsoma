# ============================================
# Portal Soma — env de PRODUÇÃO
# ============================================
# Copie pra Coolify env panel (NÃO commitar)

# === Postgres ===
POSTGRES_USER=nivertotal
POSTGRES_PASSWORD=          # gerar senha forte
POSTGRES_DB=nivertotal
DATABASE_URL=postgresql://nivertotal:CHANGEME@postgres:5432/nivertotal?schema=public

# === Redis ===
REDIS_PASSWORD=             # gerar senha forte
REDIS_URL=redis://default:CHANGEME@redis:6379

# === Anthropic ===
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=2048

# === Replicate (Flux) ===
REPLICATE_API_TOKEN=
REPLICATE_FLUX_PRO_MODEL=black-forest-labs/flux-1.1-pro
REPLICATE_FLUX_SCHNELL_MODEL=black-forest-labs/flux-schnell

# === Cloudflare R2 (storage de imagens) ===
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=portalsoma-media
R2_PUBLIC_URL=https://media.portalsoma.com.br

# === SerpAPI (atualiza serpScore — opcional Sprint 2) ===
SERPAPI_KEY=

# === IndexNow (Bing/Yandex) ===
INDEXNOW_KEY=                # gerar key 32 chars hex e servir em /<key>.txt

# === Admin auth ===
NEXTAUTH_SECRET=             # 32+ chars random — `openssl rand -base64 32`
ADMIN_URL=https://admin.portalsoma.com.br

# === Site público ===
NEXT_PUBLIC_SITE_URL=https://portalsoma.com.br
NEXT_PUBLIC_SITE_NAME=Portal Soma

# === Scheduler ===
LIMITE_GLOBAL_DIA=50         # mensagens/dia max gerar via IA
